{
	"name": "pfloop",
	"version": "1.0.0",
	"description": "Pfloop — Pfand-Abhol-PWA (Cloudflare Workers + D1)",
	"private": true,
	"license": "PolyForm-Noncommercial-1.0.0",
	"author": "jango-blockchained <op@hoox.sh>",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "npm run build && vite preview",
		"deploy": "npm run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"db:migrate:local": "wrangler d1 migrations apply grabme --local",
		"db:migrate:remote": "wrangler d1 migrations apply grabme --remote",
		"check": "tsc -b && vite build && wrangler deploy --dry-run",
		"lint": "eslint .",
		"android:sync": "npm run build && npx cap sync android",
		"android:open": "npx cap open android",
		"android:add": "npx cap add android",
		"android:copy": "npx cap copy android",
		"android:update": "npx cap update android",
		"android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug && mkdir -p ../exports && cp -f app/build/outputs/apk/debug/app-debug.apk ../exports/Pfloop-debug.apk && ls -lh ../exports/Pfloop-debug.apk",
		"ios:sync": "npm run build && npx cap sync ios",
		"ios:open": "npx cap open ios",
		"ios:add": "npx cap add ios",
		"ios:copy": "npx cap copy ios",
		"ios:update": "npx cap update ios",
		"cap:sync": "npm run build && npx cap sync"
	},
	"dependencies": {
		"@capacitor/android": "^8.5.0",
		"@capacitor/app": "^8.1.1",
		"@capacitor/browser": "^8.0.4",
		"@capacitor/core": "^8.5.0",
		"@capacitor/ios": "^8.5.0",
		"@capacitor/splash-screen": "^8.0.2",
		"@capacitor/status-bar": "^8.0.3",
		"hono": "^4.11.1",
		"leaflet": "^1.9.4",
		"react": "^19.2.1",
		"react-dom": "^19.2.1",
		"react-leaflet": "^5.0.0",
		"react-router-dom": "^7.9.0"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.5.0",
		"@cloudflare/vite-plugin": "^1.15.3",
		"@types/leaflet": "^1.9.20",
		"@types/node": "^24.10.1",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.1",
		"typescript": "^5.9.3",
		"vite": "^7.0.0",
		"vite-plugin-pwa": "^1.0.3",
		"wrangler": "^4.88.0"
	},
	"allowScripts": {
		"workerd@1.20260801.1": true,
		"esbuild@0.28.1": true
	}
}
